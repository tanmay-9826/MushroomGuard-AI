# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
secrets.*

# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local databases and runtime state
*.db
*.sqlite
*.sqlite3
database/*.db
instance/
backups/*
