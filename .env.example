# Copy this file to .env and change values for your PC.
# Leave MUSHROOMGUARD_COM empty until you know the UNO's COM port.
MUSHROOMGUARD_COM=COM4
MUSHROOMGUARD_BAUD=9600
MUSHROOMGUARD_CAMERA=0
# Optional Android phone camera (Camlora). Use the IP/port shown by Camlora.
# Example for USB tethering; change this if the phone's address changes.
CAMLORA_BASE_URL=
MUSHROOMGUARD_SECRET=replace_with_a_random_secret_before_running

# ThingSpeak cloud bridge (keep the actual .env file private; never commit it)
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_WRITE_API_KEY=
THINGSPEAK_READ_API_KEY=
THINGSPEAK_UPDATE_INTERVAL=20
THINGSPEAK_TIMEOUT=8

# Camlora video recorder limits (MP4 is saved locally on this PC)
CAMLORA_MAX_RECORDING_SECONDS=600
CAMLORA_MAX_RECORDING_MB=300
CAMLORA_RECORDING_FPS=8
VIDEO_FRAME_INTERVAL_SECONDS=5
VIDEO_MAX_EXTRACTED_FRAMES=120
